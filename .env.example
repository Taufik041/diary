# Neon Postgres connection string (pooled).
# Tables are created in a dedicated `diary` schema, so this database can be
# shared with other projects without name collisions.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Password for signing in (the whole site is private)
ADMIN_PASSWORD=change-me

# Secret used to HMAC-sign the admin cookie.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Cloudinary — uploads are signed server-side, sent direct from the browser
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
